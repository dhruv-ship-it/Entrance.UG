generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  SUB_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum QuestionType {
  MCQ
  MULTIPLE_CORRECT
  INTEGER
  TRUE_FALSE
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

enum AnswerStatus {
  CORRECT
  INCORRECT
  PARTIALLY_CORRECT
  UNATTEMPTED
}

enum EmailVerificationPurpose {
  REGISTER
  FORGOT_PASSWORD
  CHANGE_EMAIL
}

enum VerificationAccountRole {
  STUDENT
  PARENT
  MENTOR
  ADMIN
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum DoubtVisibility {
  PUBLIC
  PRIVATE
}

enum DoubtStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  MANUAL
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PurchaseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum NoticePriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  SYSTEM
  MOCK
  CONTENT
  MENTORSHIP
  RC
  PURCHASE
}

model Admin {
  id                              String   @id @default(uuid()) @db.Uuid
  name                            String   @db.VarChar(150)
  username                        String   @unique @db.VarChar(50)
  email                           String   @unique @db.VarChar(320)
  emailVerified                   Boolean  @default(false) @map("email_verified")
  emailVerifiedAt                 DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordHash                    String   @map("password_hash") @db.VarChar(255)
  role                            AdminRole @default(SUB_ADMIN)
  isActive                        Boolean  @default(true) @map("is_active")
  lastLoginAt                     DateTime? @map("last_login_at") @db.Timestamptz(3)
  canManageStudents               Boolean  @default(false) @map("can_manage_students")
  canManageParents                Boolean  @default(false) @map("can_manage_parents")
  canManageMentors                Boolean  @default(false) @map("can_manage_mentors")
  canManageMockTests              Boolean  @default(false) @map("can_manage_mock_tests")
  canManageContent                Boolean  @default(false) @map("can_manage_content")
  canManageRcTests                Boolean  @default(false) @map("can_manage_rc_tests")
  canManageMentorship             Boolean  @default(false) @map("can_manage_mentorship")
  canManagePlans                  Boolean  @default(false) @map("can_manage_plans")
  canManageAnalytics              Boolean  @default(false) @map("can_manage_analytics")
  canManageFeedback               Boolean  @default(false) @map("can_manage_feedback")
  canManageDashboardNotices       Boolean  @default(false) @map("can_manage_dashboard_notices")
  canManageWebsiteSettings        Boolean  @default(false) @map("can_manage_website_settings")
  canManageAdmins                 Boolean  @default(false) @map("can_manage_admins")
  createdById                     String?  @map("created_by") @db.Uuid
  updatedById                     String?  @map("updated_by") @db.Uuid
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                       Admin?   @relation("AdminCreatedAdmins", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                       Admin?   @relation("AdminUpdatedAdmins", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAdmins                   Admin[]  @relation("AdminCreatedAdmins")
  updatedAdmins                   Admin[]  @relation("AdminUpdatedAdmins")
  createdMentors                  Mentor[] @relation("AdminCreatedMentors")
  updatedMentors                  Mentor[] @relation("AdminUpdatedMentors")
  createdExamTypes                ExamType[] @relation("AdminCreatedExamTypes")
  updatedExamTypes                ExamType[] @relation("AdminUpdatedExamTypes")
  createdMockExamTypes            MockExamType[] @relation("AdminCreatedMockExamTypes")
  updatedMockExamTypes            MockExamType[] @relation("AdminUpdatedMockExamTypes")
  createdMockSectionTypes         MockSectionType[] @relation("AdminCreatedMockSectionTypes")
  updatedMockSectionTypes         MockSectionType[] @relation("AdminUpdatedMockSectionTypes")
  createdMockExams                MockExam[] @relation("AdminCreatedMockExams")
  updatedMockExams                MockExam[] @relation("AdminUpdatedMockExams")
  createdMockSections             MockSection[] @relation("AdminCreatedMockSections")
  updatedMockSections             MockSection[] @relation("AdminUpdatedMockSections")
  createdMockComprehensions       MockComprehension[] @relation("AdminCreatedMockComprehensions")
  updatedMockComprehensions       MockComprehension[] @relation("AdminUpdatedMockComprehensions")
  createdMockQuestions            MockQuestion[] @relation("AdminCreatedMockQuestions")
  updatedMockQuestions            MockQuestion[] @relation("AdminUpdatedMockQuestions")
  createdSubjects                 Subject[] @relation("AdminCreatedSubjects")
  updatedSubjects                 Subject[] @relation("AdminUpdatedSubjects")
  createdTopics                   Topic[] @relation("AdminCreatedTopics")
  updatedTopics                   Topic[] @relation("AdminUpdatedTopics")
  createdSubtopics                Subtopic[] @relation("AdminCreatedSubtopics")
  updatedSubtopics                Subtopic[] @relation("AdminUpdatedSubtopics")
  createdDifficultyLevels         DifficultyLevel[] @relation("AdminCreatedDifficultyLevels")
  updatedDifficultyLevels         DifficultyLevel[] @relation("AdminUpdatedDifficultyLevels")
  createdContents                 Content[] @relation("AdminCreatedContents")
  updatedContents                 Content[] @relation("AdminUpdatedContents")
  createdContentTests             ContentTest[] @relation("AdminCreatedContentTests")
  updatedContentTests             ContentTest[] @relation("AdminUpdatedContentTests")
  createdContentSections          ContentSection[] @relation("AdminCreatedContentSections")
  updatedContentSections          ContentSection[] @relation("AdminUpdatedContentSections")
  createdContentComprehensions    ContentComprehension[] @relation("AdminCreatedContentComprehensions")
  updatedContentComprehensions    ContentComprehension[] @relation("AdminUpdatedContentComprehensions")
  createdContentQuestions         ContentQuestion[] @relation("AdminCreatedContentQuestions")
  updatedContentQuestions         ContentQuestion[] @relation("AdminUpdatedContentQuestions")
  createdMentorshipPrograms       MentorshipProgram[] @relation("AdminCreatedMentorshipPrograms")
  updatedMentorshipPrograms       MentorshipProgram[] @relation("AdminUpdatedMentorshipPrograms")
  createdMentorshipBatches        MentorshipBatch[] @relation("AdminCreatedMentorshipBatches")
  updatedMentorshipBatches        MentorshipBatch[] @relation("AdminUpdatedMentorshipBatches")
  createdBatchTests               BatchTest[] @relation("AdminCreatedBatchTests")
  updatedBatchTests               BatchTest[] @relation("AdminUpdatedBatchTests")
  createdBatchNotices             BatchNotice[] @relation("AdminCreatedBatchNotices")
  updatedBatchNotices             BatchNotice[] @relation("AdminUpdatedBatchNotices")
  createdBatchSections            BatchSection[] @relation("AdminCreatedBatchSections")
  updatedBatchSections            BatchSection[] @relation("AdminUpdatedBatchSections")
  createdBatchComprehensions      BatchComprehension[] @relation("AdminCreatedBatchComprehensions")
  updatedBatchComprehensions      BatchComprehension[] @relation("AdminUpdatedBatchComprehensions")
  createdBatchQuestions           BatchQuestion[] @relation("AdminCreatedBatchQuestions")
  updatedBatchQuestions           BatchQuestion[] @relation("AdminUpdatedBatchQuestions")
  doubtReplies                    DoubtReply[] @relation("AdminDoubtReplies")
  mentorBatchAssignments          MentorBatchAssignment[] @relation("AdminAssignedMentorBatches")
  createdRcTests                  RcTest[] @relation("AdminCreatedRcTests")
  updatedRcTests                  RcTest[] @relation("AdminUpdatedRcTests")
  createdPlans                    Plan[] @relation("AdminCreatedPlans")
  updatedPlans                    Plan[] @relation("AdminUpdatedPlans")
  createdDashboardNotifications   DashboardNotification[] @relation("AdminCreatedDashboardNotifications")
  updatedDashboardNotifications   DashboardNotification[] @relation("AdminUpdatedDashboardNotifications")
  updatedWebsiteSettings          WebsiteSettings[] @relation("AdminUpdatedWebsiteSettings")

  @@map("admins")
}

model Mentor {
  id                        String   @id @default(uuid()) @db.Uuid
  name                      String   @db.VarChar(150)
  username                  String   @unique @db.VarChar(50)
  email                     String   @unique @db.VarChar(320)
  emailVerified             Boolean  @default(false) @map("email_verified")
  emailVerifiedAt           DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneNumber               String   @unique @map("phone_number") @db.VarChar(20)
  passwordHash              String   @map("password_hash") @db.VarChar(255)
  qualification             String   @db.VarChar(255)
  experienceYears           Int      @default(0) @map("experience_years")
  bio                       String?  @db.Text
  profileImage              String?  @map("profile_image") @db.VarChar(2048)
  isActive                  Boolean  @default(true) @map("is_active")
  lastLoginAt               DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdById               String   @map("created_by") @db.Uuid
  updatedById               String   @map("updated_by") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                 Admin    @relation("AdminCreatedMentors", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                 Admin    @relation("AdminUpdatedMentors", fields: [updatedById], references: [id], onDelete: Restrict)
  batchAssignments          MentorBatchAssignment[]
  createdBatchTasks         BatchTask[] @relation("MentorCreatedBatchTasks")
  updatedBatchTasks         BatchTask[] @relation("MentorUpdatedBatchTasks")
  createdBatchNotices       BatchNotice[] @relation("MentorCreatedBatchNotices")
  updatedBatchNotices       BatchNotice[] @relation("MentorUpdatedBatchNotices")
  doubtReplies              DoubtReply[]
  createdLiveSessions       LiveSession[]
  createdBatchTests         BatchTest[] @relation("MentorCreatedBatchTests")
  updatedBatchTests         BatchTest[] @relation("MentorUpdatedBatchTests")
  createdBatchSections      BatchSection[] @relation("MentorCreatedBatchSections")
  updatedBatchSections      BatchSection[] @relation("MentorUpdatedBatchSections")
  createdBatchComprehensions BatchComprehension[] @relation("MentorCreatedBatchComprehensions")
  updatedBatchComprehensions BatchComprehension[] @relation("MentorUpdatedBatchComprehensions")
  createdBatchQuestions     BatchQuestion[] @relation("MentorCreatedBatchQuestions")
  updatedBatchQuestions     BatchQuestion[] @relation("MentorUpdatedBatchQuestions")

  @@map("mentors")
}

model Student {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String   @db.VarChar(150)
  username                 String   @unique @db.VarChar(50)
  email                    String?  @unique @db.VarChar(320)
  emailVerified            Boolean  @default(false) @map("email_verified")
  emailVerifiedAt          DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneNumber              String   @unique @map("phone_number") @db.VarChar(20)
  passwordHash             String   @map("password_hash") @db.VarChar(255)
  dateOfBirth              DateTime @map("date_of_birth") @db.Date
  gender                   Gender
  profileImage             String?  @map("profile_image") @db.VarChar(2048)
  schoolName               String?  @map("school_name") @db.VarChar(255)
  className                String?  @map("class_name") @db.VarChar(100)
  city                     String?  @db.VarChar(100)
  state                    String?  @db.VarChar(100)
  isActive                 Boolean  @default(true) @map("is_active")
  lastLoginAt              DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastSeenAt               DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  parentLinks              ParentStudent[]
  mockAttempts             MockAttempt[]
  mockAccesses             StudentMockAccess[]
  contentAccesses          StudentContentAccess[]
  contentCompletions       StudentContentCompletion[]
  contentNotes             ContentNote[]
  contentAttempts          ContentAttempt[]
  batchAccesses            StudentBatchAccess[]
  completedTasks           CompletedTask[]
  doubts                   Doubt[]
  doubtReplies             DoubtReply[]
  attendance               Attendance[]
  batchAttempts            BatchAttempt[]
  rcAttempts               RcAttempt[]
  rcLeaderboard            RcLeaderboard?
  payments                 Payment[]
  purchases                Purchase[]
  feedback                 Feedback[]
  notifications            StudentNotification[]
  seenDashboardNotifications StudentDashboardNotificationSeen[]

  @@index([isActive])
  @@map("students")
}

model Parent {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(150)
  username          String   @unique @db.VarChar(50)
  email             String   @unique @db.VarChar(320)
  emailVerified     Boolean  @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  phoneNumber       String   @unique @map("phone_number") @db.VarChar(20)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  occupation        String?  @db.VarChar(255)
  isActive          Boolean  @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  studentLinks      ParentStudent[]

  @@index([isActive])
  @@map("parents")
}

model ParentStudent {
  parentId      String             @map("parent_id") @db.Uuid
  studentId     String             @map("student_id") @db.Uuid
  relationship  ParentRelationship
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  parent        Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
  @@map("parent_student")
}

model Subject {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(150)
  description  String   @db.Text
  displayOrder Int      @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    Admin    @relation("AdminCreatedSubjects", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedSubjects", fields: [updatedById], references: [id], onDelete: Restrict)
  topics       Topic[]

  @@unique([displayOrder])
  @@map("subjects")
}

model Topic {
  id           String   @id @default(uuid()) @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  name         String   @db.VarChar(150)
  description  String   @db.Text
  displayOrder Int      @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy    Admin    @relation("AdminCreatedTopics", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedTopics", fields: [updatedById], references: [id], onDelete: Restrict)
  subtopics    Subtopic[]
  mockQuestions MockQuestion[]
  contentTests ContentTest[]
  contentQuestions ContentQuestion[]
  batchQuestions BatchQuestion[]

  @@unique([subjectId, name])
  @@unique([subjectId, displayOrder])
  @@map("topics")
}

model Subtopic {
  id           String   @id @default(uuid()) @db.Uuid
  topicId      String   @map("topic_id") @db.Uuid
  name         String   @db.VarChar(150)
  description  String   @db.Text
  displayOrder Int      @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  createdBy    Admin    @relation("AdminCreatedSubtopics", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedSubtopics", fields: [updatedById], references: [id], onDelete: Restrict)
  contents     Content[]
  mockQuestions MockQuestion[]
  contentQuestions ContentQuestion[]
  batchQuestions BatchQuestion[]

  @@unique([topicId, name])
  @@unique([topicId, displayOrder])
  @@map("subtopics")
}

model DifficultyLevel {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(50)
  description  String   @db.Text
  displayOrder Int      @unique @map("display_order")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    Admin    @relation("AdminCreatedDifficultyLevels", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedDifficultyLevels", fields: [updatedById], references: [id], onDelete: Restrict)
  mockExams    MockExam[]
  mockQuestions MockQuestion[]
  contentTests ContentTest[]
  contentQuestions ContentQuestion[]
  batchTests   BatchTest[]
  batchQuestions BatchQuestion[]
  rcTests      RcTest[]

  @@map("difficulty_levels")
}

model ExamType {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  description  String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    Admin    @relation("AdminCreatedExamTypes", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedExamTypes", fields: [updatedById], references: [id], onDelete: Restrict)
  mockExams    MockExam[]
  studentAccesses StudentMockAccess[]
  planLinks    PlanMockExam[]

  @@map("exam_types")
}

model MockExamType {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  description  String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    Admin    @relation("AdminCreatedMockExamTypes", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedMockExamTypes", fields: [updatedById], references: [id], onDelete: Restrict)
  mockExams    MockExam[]

  @@map("mock_exam_types")
}

model MockSectionType {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  description  String   @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    Admin    @relation("AdminCreatedMockSectionTypes", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedMockSectionTypes", fields: [updatedById], references: [id], onDelete: Restrict)
  mockSections MockSection[]

  @@map("mock_section_types")
}

model MockExam {
  id                            String   @id @default(uuid()) @db.Uuid
  examTypeId                    String   @map("exam_type_id") @db.Uuid
  mockExamTypeId                String   @map("mock_exam_type_id") @db.Uuid
  name                          String   @db.VarChar(255)
  description                   String   @db.Text
  instructions                  String   @db.Text
  difficultyId                  String   @map("difficulty_id") @db.Uuid
  durationMinutes               Int      @map("duration_minutes")
  totalMarks                    Decimal  @map("total_marks") @db.Decimal(10, 2)
  passingMarks                  Decimal? @map("passing_marks") @db.Decimal(10, 2)
  canGoBackBetweenSections      Boolean  @default(false) @map("can_go_back_between_sections")
  isFree                        Boolean  @default(false) @map("is_free")
  isActive                      Boolean  @default(true) @map("is_active")
  createdById                   String   @map("created_by") @db.Uuid
  updatedById                   String   @map("updated_by") @db.Uuid
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  examType                      ExamType @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  mockExamType                  MockExamType @relation(fields: [mockExamTypeId], references: [id], onDelete: Restrict)
  difficulty                    DifficultyLevel @relation(fields: [difficultyId], references: [id], onDelete: Restrict)
  createdBy                     Admin    @relation("AdminCreatedMockExams", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                     Admin    @relation("AdminUpdatedMockExams", fields: [updatedById], references: [id], onDelete: Restrict)
  sections                      MockSection[]
  attempts                      MockAttempt[]
  analytics                     MockAttemptAnalytics?

  @@index([examTypeId, isActive])
  @@map("mock_exams")
}

model MockSection {
  id                                String   @id @default(uuid()) @db.Uuid
  mockExamId                        String   @map("mock_exam_id") @db.Uuid
  mockSectionTypeId                 String   @map("mock_section_type_id") @db.Uuid
  sequenceNumber                    Int      @map("sequence_number")
  name                              String   @db.VarChar(255)
  instructions                      String   @db.Text
  durationMinutes                   Int?     @map("duration_minutes")
  totalMarks                        Decimal  @map("total_marks") @db.Decimal(10, 2)
  canGoBackToPreviousQuestion       Boolean  @default(false) @map("can_go_back_to_previous_question")
  isOptional                        Boolean  @default(false) @map("is_optional")
  createdById                       String   @map("created_by") @db.Uuid
  updatedById                       String   @map("updated_by") @db.Uuid
  createdAt                         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  mockExam                          MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  mockSectionType                   MockSectionType @relation(fields: [mockSectionTypeId], references: [id], onDelete: Restrict)
  createdBy                         Admin    @relation("AdminCreatedMockSections", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                         Admin    @relation("AdminUpdatedMockSections", fields: [updatedById], references: [id], onDelete: Restrict)
  questions                         MockQuestion[]
  attemptSections                   MockAttemptSection[]
  attemptAnswers                    MockAttemptAnswer[]
  analytics                         MockSectionAnalytics?

  @@unique([mockExamId, sequenceNumber])
  @@map("mock_sections")
}

model MockComprehension {
  id           String   @id @default(uuid()) @db.Uuid
  title        String?  @db.VarChar(255)
  passage      String   @db.Text
  createdById  String   @map("created_by") @db.Uuid
  updatedById  String   @map("updated_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    Admin    @relation("AdminCreatedMockComprehensions", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    Admin    @relation("AdminUpdatedMockComprehensions", fields: [updatedById], references: [id], onDelete: Restrict)
  questions    MockQuestion[]

  @@map("mock_comprehensions")
}

model MockQuestion {
  id                    String   @id @default(uuid()) @db.Uuid
  mockSectionId         String   @map("mock_section_id") @db.Uuid
  mockComprehensionId   String?  @map("mock_comprehension_id") @db.Uuid
  topicId               String   @map("topic_id") @db.Uuid
  subtopicId            String   @map("subtopic_id") @db.Uuid
  difficultyId          String   @map("difficulty_id") @db.Uuid
  sequenceNumber        Int      @map("sequence_number")
  questionType          QuestionType @map("question_type")
  question              String   @db.Text
  options               Json?
