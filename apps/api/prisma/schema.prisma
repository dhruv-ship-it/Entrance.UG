  mentorId       String?  @map("mentor_id") @db.Uuid
  studentId      String?  @map("student_id") @db.Uuid
  adminId        String?  @map("admin_id") @db.Uuid
  replyText      String   @map("reply_text") @db.Text
  attachmentUrl  String?  @map("attachment_url") @db.VarChar(2048)
  isEdited       Boolean  @default(false) @map("is_edited")
  isPinned       Boolean  @default(false) @map("is_pinned")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  doubt          Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  parentReply    DoubtReply? @relation("DoubtReplyThread", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies   DoubtReply[] @relation("DoubtReplyThread")
  mentor         Mentor?  @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  student        Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
