  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  difficulty      DifficultyLevel @relation(fields: [difficultyId], references: [id], onDelete: Restrict)
  createdBy       Admin    @relation("AdminCreatedRcTests", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       Admin    @relation("AdminUpdatedRcTests", fields: [updatedById], references: [id], onDelete: Restrict)
  questions       RcQuestion[]
  attempts        RcAttempt[]
  analytics       RcTestAnalytics?

  @@index([isActive, startDatetime, endDatetime])
  @@map("rc_tests")
}

model RcQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  rcTestId       String   @map("rc_test_id") @db.Uuid
  sequenceNumber Int      @map("sequence_number")
  question       String   @db.Text
  questionType   QuestionType @map("question_type")
  options        Json?
  correctAnswers Json     @map("correct_answers")
  positiveMarks  Decimal  @map("positive_marks") @db.Decimal(10, 2)
  negativeMarks  Decimal  @default(0) @map("negative_marks") @db.Decimal(10, 2)
  explanation    String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  rcTest         RcTest   @relation(fields: [rcTestId], references: [id], onDelete: Cascade)
  attemptAnswers RcAttemptAnswer[]

  @@unique([rcTestId, sequenceNumber])
  @@map("rc_questions")
}

model RcAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  rcTestId            String   @map("rc_test_id") @db.Uuid
  startedAt           DateTime @map("started_at") @db.Timestamptz(3)
  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz(3)
  timeTakenSeconds    Int      @default(0) @map("time_taken_seconds")
  totalMarks          Decimal  @map("total_marks") @db.Decimal(10, 2)
  marksScored         Decimal  @default(0) @map("marks_scored") @db.Decimal(10, 2)
  correctAnswers      Int      @default(0) @map("correct_answers")
  incorrectAnswers    Int      @default(0) @map("incorrect_answers")
  unattemptedAnswers  Int      @default(0) @map("unattempted_answers")
  accuracy            Decimal  @default(0) @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rcTest              RcTest   @relation(fields: [rcTestId], references: [id], onDelete: Restrict)
  answers             RcAttemptAnswer[]

  @@index([studentId, rcTestId])
  @@index([rcTestId, submittedAt])
  @@unique([studentId, rcTestId])
  @@map("rc_attempts")
}

model RcAttemptAnswer {
  id                  String   @id @default(uuid()) @db.Uuid
  rcAttemptId         String   @map("rc_attempt_id") @db.Uuid
  rcQuestionId        String   @map("rc_question_id") @db.Uuid
